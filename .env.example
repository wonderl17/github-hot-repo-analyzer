VITE_APP_NAME="GitHub Hot Repo Analyzer"
VITE_API_BASE_URL="http://localhost:8787"

# Worker secrets are configured with Wrangler, not exposed to the browser:
# wrangler secret put GITHUB_TOKEN
# wrangler secret put OPENAI_API_KEY

# Worker vars for repo learning maps are configured in wrangler.toml:
# REPO_ANALYSIS_CACHE_TTL_SECONDS
# REPO_FILE_SAMPLE_LIMIT
